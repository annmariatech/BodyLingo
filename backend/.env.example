# Leave blank for the local SQLite fallback, or set a PostgreSQL URL, for example:
# postgresql+psycopg://bodylingo:change-me@localhost:5432/bodylingo
DATABASE_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
